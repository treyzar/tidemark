{
  "hooks": {
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "@HOOK@", "timeout": 60 }] }
    ],
    "PreToolUse": [
      { "matcher": "AskUserQuestion", "hooks": [{ "type": "command", "command": "@HOOK@", "timeout": 60 }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "@HOOK@", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "@HOOK@", "timeout": 10 }] }
    ]
  }
}
